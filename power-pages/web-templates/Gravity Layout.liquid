<!doctype html>
<html lang="{{ website.selected_language.code | default: 'en-GB' }}" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#05060B">
  <meta name="color-scheme" content="dark">
  <title>{% if page.title %}{{ page.title | escape }} | {% endif %}Gravity</title>
  <meta name="description" content="{{ page.description | default: 'Gravity is a fictional UK bank demonstration. Your money, your orbit.' | escape }}">
  <link rel="icon" type="image/png" sizes="32x32" href="/gravity-favicon-32.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Lexend+Exa:wght@400;500&amp;family=Lexend:wght@300;400;500;600&amp;display=swap">
  <link rel="stylesheet" href="/gravity.css">
  {% block head %}{% endblock %}
</head>
<body class="gravity-page" data-page="{{ page.adx_partialurl | escape }}">
  <a class="skip-link" href="#main">Skip to main content</a>
  <div class="demo-banner" role="note">
    <span class="demo-banner__dot" aria-hidden="true"></span>
    Gravity is a fictional demonstration bank. All people, balances and activity are synthetic.
  </div>
  {% include 'Gravity Header' %}
  <main id="main" tabindex="-1"{% if page.adx_partialurl == 'my-gravity' or page.adx_partialurl == 'account' or page.adx_partialurl == 'transaction' or page.adx_partialurl == 'banking-request' %} class="banking-main"{% endif %}>
    {{ page.adx_copy }}
  </main>
  {% include 'Gravity Footer' %}
  <script src="/gravity.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
